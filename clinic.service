[Unit]
Description=Al Faidy Clinic System
After=network.target

[Service]
Type=simple
User=nashaat
WorkingDirectory=/home/nashaat/Downloads/clinic-management-system
Environment="FLASK_ENV=production"
ExecStart=/home/nashaat/Downloads/clinic-management-system/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 run:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
